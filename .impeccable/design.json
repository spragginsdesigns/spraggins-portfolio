  "narrative": {
    "northStar": "Engineering clarity, personal conviction",
    "overview": "The established portfolio uses dark surfaces, cyan accents, Inter body text and Poppins headings. Its project cards and navigation support scanning professional work. The faith section is an approved local editorial treatment: warm charcoal, gold, large serif statements and illuminated cross imagery.\n\nThe faith treatment stays inside its section. Its open composition gives readable testimony and Scripture room beside each other, then closes with a SureWord invitation. Source extraction records the implemented styles; refreshed browser acceptance belongs to the finish review.",
    "keyCharacteristics": [
      "Dark cyan portfolio with a scoped warm faith palette.",
      "Clear sans-serif interface paired locally with expressive serif typography.",
      "Responsive editorial spacing, native links and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Scoped Warmth Rule",
        "body": "Keep faith colors and serif typography local; preserve the surrounding portfolio identity.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** preserve the global cyan, Inter and Poppins identity outside faith.",
      "**Do** use DM Serif Display at weight 400 for faith display text and Scripture.",
      "**Do** preserve native anchor behavior, visible focus and reduced-motion support.",
      "**Do** keep testimony readable and visible without opening a modal or disclosure."
    ],
    "donts": [
      "**Don't** promote faith tokens into global replacements.",
      "**Don't** place faith testimony into a stack of generic cards.",
      "**Don't** add animation that bypasses reduced-motion preferences."
    ]
  }
